<?xml version="1.0" encoding="utf-8"?>
<!-- The link between the two phones is plain TCP on the local network, and pages may be
     loaded over http, so cleartext is allowed for private addresses only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
