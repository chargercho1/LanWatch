<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.lanwatch.agent"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- The desktop lives on the local network; the phone dials it and answers a discovery ping. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android 8 and newer require an explicit permission for a foreground service. On 5.1 the
         same service runs from startForeground without it, which is why the manifest still
         declares it: harmless there, mandatory later. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- The ongoing notification. Not shown on 5.1 (no runtime prompts before 6.0), asked once
         from 6.0, and a no-op from 13 where notifications are granted at install time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".AgentActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started when the app is opened and restarted if the system reclaims it, so the
             desktop keeps seeing this phone's battery rather than a frozen reading. -->
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>